{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Nero Static Server",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{let u=q.url==='/'?'/index.html':decodeURIComponent(q.url).split('?')[0];let fp=p.join(process.cwd(),u);let ct={'html':'text/html','css':'text/css','js':'application/javascript','png':'image/png','jpg':'image/jpeg','svg':'image/svg+xml'}[p.extname(fp).slice(1)]||'application/octet-stream';f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end();}else{r.writeHead(200,{'Content-Type':ct});r.end(d);}});}).listen(3000)"],
      "port": 3000
    }
  ]
}
